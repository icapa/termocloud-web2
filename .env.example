# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# Get these values from: https://console.firebase.google.com/
# Go to Project Settings (⚙️) → General → Your apps → Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Optional: Only needed for Analytics and advanced features
# VITE_FIREBASE_APP_ID=your-app-id

# Optional: Realtime Database URL (auto-detected if not provided)
# VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
